# Copy this file to .env and fill in real values.

# Required to enable GET /debug/sessions. If unset, that route always 404s.
# Send it back as the "X-Debug-Token" header.
DEBUG_TOKEN=

# Logging. LOG_LEVEL: debug | info | warn | error | silent (default info).
# debug adds raw message payloads and state changes.
# LOG_FORMAT: pretty (default, human-readable) | json (one JSON object per
# line, for log aggregation). Colour is automatic on a terminal; NO_COLOR=1
# turns it off, FORCE_COLOR=1 forces it on.
# LOG_LEVEL=info
# LOG_FORMAT=pretty

# Optional resource limits — the values below are the defaults. Each must be a
# positive integer; anything else is ignored (with a warning) in favour of the default.
# MAX_CONNECTIONS=1000
# MAX_SESSIONS=1000
# MAX_CLIENTS_PER_SESSION=100
# MESSAGE_RATE_PER_SEC=40
# MESSAGE_BURST=80
